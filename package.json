{
  "name": "nukun",
  "productName": "Nukun",
  "version": "1.0.0",
  "description": "Nùkún : la science et l'actualité qui t'intéressent, en libre accès, traduites et expliquées simplement.",
  "author": "HANTAN Hugues",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run dist && node scripts/release.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@huggingface/transformers": "^4.3.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.51.0",
    "lucide-static": "^1.51.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.hantan.nukun",
    "publish": [
      {
        "provider": "github",
        "owner": "hantanHugues",
        "repo": "nukun"
      }
    ],
    "productName": "Nukun",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!node_modules/onnxruntime-web/dist/*.wasm",
      "!node_modules/onnxruntime-web/**/*.map",
      "!node_modules/@img/sharp-wasm32/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Nukun",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "createStartMenuShortcut": true,
      "shortcutName": "Nùkún",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Nukun-Setup-${version}.${ext}",
      "uninstallDisplayName": "Nùkún"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Science",
      "executableName": "nukun",
      "synopsis": "Nùkún garde un œil sur le monde",
      "description": "Veille scientifique : articles en libre accès traduits et expliqués, recommandés selon tes lectures.",
      "maintainer": "Ashlynx <hugueshantan@gmail.com>",
      "artifactName": "Nukun-${version}.${ext}",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_*"
      ]
    },
    "deb": {
      "artifactName": "nukun_${version}_amd64.${ext}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hantanHugues/nukun.git"
  }
}
