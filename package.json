{
  "name": "veille-scientifique",
  "productName": "Veille Scientifique",
  "version": "1.0.0",
  "description": "Veille scientifique personnelle : articles en libre accès, traduits en français, recommandés selon tes lectures.",
  "author": "HANTAN Hugues",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.51.0",
    "lucide-static": "^1.51.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.hantan.veille",
    "productName": "Veille Scientifique",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "VeilleScientifique"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Veille Scientifique",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Veille-Scientifique-Setup-${version}.${ext}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hantanHugues/veille-scientifique.git"
  }
}
